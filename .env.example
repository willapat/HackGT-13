# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Settings -> API Keys -> Publishable key (sb_publishable_...). Safe for the frontend.
SUPABASE_PUBLISHABLE_KEY=
# Settings -> API Keys -> Secret keys (sb_secret_...). Backend only; bypasses all security rules.
SUPABASE_SECRET_KEY=
# Connect button (top of dashboard) -> Session pooler string, with your DB password in place of [YOUR-PASSWORD]
SUPABASE_DB_URL=
# xAI (Grok) API key (xai-...). When set, every AI feature uses xAI; OpenRouter below is the backup option.
XAI_API_KEY=
# Optional Grok model overrides and provider switch (xai / openrouter; empty = xAI if its key is set)
# XAI_MODEL=grok-4.6
# XAI_FAST_MODEL=grok-4.20-0309-non-reasoning
# XAI_REASONING_EFFORT=low
# LLM_PROVIDER=
# OpenRouter API key (sk-or-v1-...). Used when there's no xAI key.
OPENROUTER_API_KEY=
BRAIN_MODEL=google/gemini-2.5-flash
AGENT_MODEL=google/gemini-2.5-flash-lite
ACTION_AGENT_MODEL=google/gemini-2.5-flash
BRAIN_LOOP_INTERVAL_SECONDS=10
AGENT_LOOP_INTERVAL_SECONDS=2
DEMO_TOWN_ID=
# Optional: town time at process start (ISO). Then advances in real time. Empty = wall clock.
# TOWN_CLOCK=2026-09-26T08:50:00-04:00
# Google Calendar sync. Same OAuth client you pasted into Supabase -> Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Events whose title/location don't name a town place are sorted by the fast model (uses the LLM key above).
# CALENDAR_AI=true
# CALENDAR_AI_MAX_CALLS=40
