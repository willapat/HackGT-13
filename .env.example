# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Settings -> API Keys -> Publishable key (sb_publishable_...). Safe for the frontend.
SUPABASE_PUBLISHABLE_KEY=
# Settings -> API Keys -> Secret keys (sb_secret_...). Backend only; bypasses all security rules.
SUPABASE_SECRET_KEY=
# Connect button (top of dashboard) -> Session pooler string, with your DB password in place of [YOUR-PASSWORD]
SUPABASE_DB_URL=
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-4-6
AGENT_MODEL=claude-haiku-4-5-20251001
ACTION_AGENT_MODEL=claude-sonnet-4-6
BRAIN_LOOP_INTERVAL_SECONDS=10
AGENT_LOOP_INTERVAL_SECONDS=2
DEMO_TOWN_ID=
