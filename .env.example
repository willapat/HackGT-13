# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Settings -> API Keys -> Publishable key (sb_publishable_...). Safe for the frontend.
SUPABASE_PUBLISHABLE_KEY=
# Settings -> API Keys -> Secret keys (sb_secret_...). Backend only; bypasses all security rules.
SUPABASE_SECRET_KEY=
# Connect button (top of dashboard) -> Session pooler string, with your DB password in place of [YOUR-PASSWORD]
SUPABASE_DB_URL=
