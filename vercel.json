{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf public && mkdir public && cp -R frontend town public/",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/frontend/",
      "permanent": false
    },
    {
      "source": "/frontend",
      "destination": "/frontend/",
      "permanent": false
    },
    {
      "source": "/town",
      "destination": "/town/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://luma-hackgt-api.fly.dev/:path*"
    }
  ]
}
